{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node deploy/vercel-build.mjs",
  "outputDirectory": "deploy/dist",
  "framework": null,
  "installCommand": "echo \"no dependencies\"",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_CATALYST_FUNCTION_URL/api/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(app|crm|calendar|setup|views|crm-setup).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
